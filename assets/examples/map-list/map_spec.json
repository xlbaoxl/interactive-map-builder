{
  "schema_version": "1.1",
  "template": "map-list",
  "title": "Lower Manhattan Commercial and Mixed-Use Parcels",
  "subtitle": "Financial District—Civic Center · 1,233 real tax lots · NYC Open Data",
  "locale": "en-US",
  "primary_layer": "parcels",
  "layers": [
    {
      "id": "parcels",
      "name": "Commercial and mixed-use tax lots",
      "source": {
        "path": "mixed-commercial.geojson"
      },
      "required": true,
      "visible": true,
      "id_field": "id",
      "label_field": "name",
      "search_fields": [
        "name",
        "address",
        "zoning",
        "bbl"
      ],
      "tooltip_fields": [
        "name",
        "category_en",
        "zoning"
      ],
      "popup_fields": [
        "address",
        "category_en",
        "land_use_en",
        "zoning",
        "lot_area_sqft",
        "building_area_sqft",
        "built_far",
        "floors",
        "year_built",
        "bbl"
      ],
      "filter_fields": [
        "land_use_code",
        "year_built",
        "floors",
        "built_far"
      ],
      "card_fields": [
        "zoning",
        "floors",
        "year_built",
        "built_far",
        "lot_area_sqft",
        "building_area_sqft"
      ],
      "sort_fields": [
        "name",
        "year_built",
        "floors",
        "built_far",
        "building_area_sqft"
      ],
      "field_labels": {
        "name": "Address",
        "address": "Address",
        "category_en": "Land-use group",
        "land_use_en": "Detailed land use",
        "zoning": "Primary zoning",
        "lot_area_sqft": "Lot area (sq ft)",
        "building_area_sqft": "Building area (sq ft)",
        "built_far": "Built FAR",
        "floors": "Floors",
        "year_built": "Year built",
        "bbl": "BBL"
      },
      "source_note": "NYC Open Data TAX_LOT_POLYGON (i38t-6if2) joined to PLUTO (64uk-42ks), snapshot 2026-07-24",
      "style": {
        "mode": "categorical",
        "color_field": "land_use_code",
        "weight": 0.75,
        "opacity": 0.92,
        "fill_opacity": 0.7,
        "categories": {
          "commercial_office": {
            "label": "Commercial and office",
            "color": "#d99037"
          },
          "mixed_residential_commercial": {
            "label": "Mixed residential and commercial",
            "color": "#39758a"
          }
        }
      }
    }
  ],
  "basemaps": [
    {
      "name": "Carto Positron",
      "url": "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors © CARTO",
      "visible": true
    },
    {
      "name": "OpenStreetMap",
      "url": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors",
      "visible": false
    }
  ],
  "map": {
    "search_behavior": "highlight",
    "controls": {
      "fullscreen": true,
      "scale": true,
      "basemap_switcher": true,
      "layer_control": false,
      "legend": true
    }
  },
  "list": {
    "batch_size": 120,
    "default_sort": "name",
    "collapsible": true,
    "summary_update_with_filter": true,
    "summary_metrics": [
      {
        "type": "count",
        "label": "Current parcels"
      },
      {
        "type": "sum",
        "field": "building_area_sqft",
        "label": "Total building area"
      },
      {
        "type": "median",
        "field": "year_built",
        "label": "Median year built"
      },
      {
        "type": "mean",
        "field": "built_far",
        "label": "Average FAR"
      }
    ]
  },
  "static": {
    "enabled": true,
    "presets": [
      "slide-16x9",
      "paper"
    ],
    "source_note": "NYC Open Data: TAX_LOT_POLYGON (i38t-6if2) joined to PLUTO (64uk-42ks), snapshot 2026-07-24"
  }
}
