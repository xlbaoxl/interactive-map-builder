{
  "schema_version": "1.1",
  "template": "multilayer",
  "title": "Downtown Brooklyn Cycling and Transit",
  "subtitle": "4 neighborhood areas · 36 bicycle routes · 16 subway stations",
  "locale": "en-US",
  "layers": [
    {
      "id": "neighborhoods",
      "name": "Neighborhood areas",
      "source": {
        "path": "neighborhoods.geojson"
      },
      "required": true,
      "id_field": "id",
      "label_field": "name",
      "field_labels": {
        "name": "Neighborhood",
        "borough": "Borough",
        "area_sqmi": "Area (sq mi)"
      },
      "source_note": "NYC Open Data: 2020 Neighborhood Tabulation Areas (9nt8-h7nd), retrieved 2026-07-24",
      "search_fields": [
        "name"
      ],
      "tooltip_fields": [
        "name"
      ],
      "popup_fields": [
        "name",
        "borough",
        "area_sqmi"
      ],
      "style": {
        "color_field": "name",
        "categories": {
          "Brooklyn Heights": "#7FAEB3",
          "Downtown Brooklyn-DUMBO-Boerum Hill": "#6E9B8A",
          "Fort Greene": "#9B8BAC",
          "Clinton Hill": "#C29B61"
        }
      }
    },
    {
      "id": "bike_routes",
      "name": "Bicycle routes",
      "source": {
        "path": "bike_routes.geojson"
      },
      "required": true,
      "id_field": "id",
      "label_field": "name",
      "field_labels": {
        "name": "Route street",
        "facility_class": "Facility class",
        "length_mi": "Length (mi)",
        "segment_count": "Source segment count"
      },
      "source_note": "NYC Open Data: New York City Bike Routes (mzxg-pwib), retrieved 2026-07-24",
      "search_fields": [
        "name"
      ],
      "tooltip_fields": [
        "name",
        "facility_class"
      ],
      "popup_fields": [
        "name",
        "facility_class",
        "length_mi",
        "segment_count"
      ],
      "style": {
        "color_field": "facility_class",
        "categories": {
          "I": "#287D7C",
          "II": "#5A8A70",
          "III": "#B98245"
        }
      }
    },
    {
      "id": "subway_stations",
      "name": "Subway stations",
      "source": {
        "path": "subway_stations.geojson"
      },
      "required": true,
      "id_field": "id",
      "label_field": "name",
      "field_labels": {
        "name": "Station",
        "routes": "Daytime routes",
        "entrance_count": "Entrance count",
        "entrance_types": "Entrance types"
      },
      "source_note": "MTA Open Data: Subway Entrances and Exits: 2024 (i9wp-a4ja), retrieved 2026-07-24",
      "search_fields": [
        "name"
      ],
      "tooltip_fields": [
        "name",
        "routes"
      ],
      "popup_fields": [
        "name",
        "routes",
        "entrance_count",
        "entrance_types"
      ],
      "style": {
        "color": "#7A3D53",
        "fill_color": "#C45F78"
      }
    }
  ],
  "basemaps": [
    {
      "name": "CARTO Positron",
      "url": "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors © CARTO",
      "visible": true,
      "max_zoom": 20
    },
    {
      "name": "OpenStreetMap Standard",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors",
      "visible": false,
      "max_zoom": 19
    }
  ],
  "map": {
    "search_behavior": "filter",
    "controls": {
      "fullscreen": true,
      "scale": true,
      "basemap_switcher": true,
      "layer_control": true,
      "legend": true
    }
  },
  "static": {
    "enabled": true,
    "presets": [
      "slide-16x9",
      "paper"
    ],
    "source_note": "NYC Open Data: Neighborhood Tabulation Areas, Bike Routes, and MTA Subway Entrances; retrieved 2026-07-24"
  }
}
