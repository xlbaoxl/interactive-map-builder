<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ page_title }}</title>
  <style>{{ leaflet_css | safe }}</style>
  <style>{{ shared_css | safe }}</style>
  <style>{{ theme_css | safe }}</style>
</head>
<body>
  <main id="imb-app" class="imb-app multilayer-app">
    <header class="imb-header">
      <button id="imb-collapse" class="imb-button" type="button" aria-controls="imb-sidebar" aria-expanded="true"></button>
      <div class="imb-heading">
        <h1 id="imb-title"></h1>
        <p id="imb-subtitle" class="imb-subtitle"></p>
      </div>
      <div id="imb-summary" class="imb-multilayer-summary" aria-live="polite"></div>
    </header>
    <div class="imb-workspace">
      <aside id="imb-sidebar" class="imb-sidebar" aria-label="{{ catalog.shared.search_map_layers }}">
        <div class="imb-toolbar">
          <div class="imb-field">
            <span id="imb-feature-type-label" class="imb-field-label"></span>
            <div
              id="imb-feature-types"
              class="imb-layer-browser"
              role="group"
              aria-labelledby="imb-feature-type-label"
            >
              <button
                id="imb-overview-button"
                class="imb-type-button imb-overview-button"
                type="button"
                aria-pressed="true"
              ></button>
              <select
                id="imb-feature-type-select"
                class="imb-select imb-layer-browser-select"
                aria-label="{{ catalog.multilayer.choose_layer }}"
              ></select>
            </div>
          </div>
          <div id="imb-search-field" class="imb-field" hidden>
            <label id="imb-search-label" for="imb-search"></label>
            <input id="imb-search" class="imb-input" type="search" autocomplete="off" disabled>
          </div>
          <p id="imb-overview-message" class="imb-overview-message"></p>
        </div>
        <div id="imb-status" class="imb-status" aria-live="polite" hidden>
          <span id="imb-result-count"></span>
          <span id="imb-result-limit"></span>
        </div>
        <div id="imb-list" class="imb-list" role="listbox" aria-label="{{ catalog.shared.search_results }}" hidden></div>
      </aside>
      <section class="imb-map-wrap" aria-label="{{ catalog.shared.interactive_multilayer_map }}">
        <div id="imb-map" class="imb-map"></div>
        <div id="imb-map-controls" class="imb-map-controls">
          <section id="imb-basemap-control" class="imb-control-card imb-basemap-control" aria-label="{{ catalog.shared.basemap }}">
            <h2 class="imb-control-title">{{ catalog.shared.basemap }}</h2>
            <div id="imb-basemap-options"></div>
          </section>
          <section id="imb-layer-control" class="imb-control-card imb-layer-control" aria-label="{{ catalog.shared.layer_control }}">
            <h2 id="imb-layer-title" class="imb-control-title"></h2>
            <div id="imb-layer-options" class="imb-control-list"></div>
          </section>
          <section id="imb-legend" class="imb-control-card imb-legend" aria-label="{{ catalog.shared.legend }}">
            <button
              id="imb-legend-toggle"
              class="imb-control-toggle"
              type="button"
              aria-controls="imb-legend-groups"
              aria-expanded="true"
            >
              <span id="imb-legend-title"></span>
              <span class="imb-control-chevron" aria-hidden="true">⌃</span>
            </button>
            <div id="imb-legend-groups" class="imb-legend-body"></div>
          </section>
        </div>
        <div id="imb-map-message" class="imb-map-message" role="alert"></div>
        <div id="imb-map-attribution" class="imb-map-attribution"></div>
      </section>
    </div>
  </main>
  <script id="imb-data" type="application/json">{{ payload_json | safe }}</script>
  <script>{{ leaflet_js | safe }}</script>
  <script>{{ shared_js | safe }}</script>
  <script>
  (function () {
    "use strict";

    InteractiveMapBuilder.onReady(function () {
      var IMB = InteractiveMapBuilder;
      var payload = IMB.parsePayload();
      var spec = payload.spec || {};
      var layers = Array.isArray(payload.layers) ? payload.layers : [];
      if (!layers.length) {
        throw new Error("The multilayer template requires at least one prepared layer.");
      }

      var locale = IMB.text(spec.locale || document.documentElement.lang || "en-US");
      var strings = payload.catalog.multilayer;
      function label(key) {
        return strings[key] || key;
      }

      var title = IMB.text(IMB.firstDefined(spec.title, "Interactive map"));
      var subtitle = IMB.text(IMB.firstDefined(spec.subtitle, ""));
      document.title = title;
      document.getElementById("imb-title").textContent = title;
      document.getElementById("imb-subtitle").textContent = subtitle;
      document.getElementById("imb-layer-title").textContent = label("layers");
      document.getElementById("imb-legend-title").textContent = label("legend");
      var legendPanel = document.getElementById("imb-legend");
      var legendToggle = document.getElementById("imb-legend-toggle");
      function setLegendCollapsed(collapsed) {
        var next = Boolean(collapsed);
        legendPanel.classList.toggle("is-collapsed", next);
        legendToggle.setAttribute("aria-expanded", next ? "false" : "true");
        legendToggle.setAttribute(
          "aria-label",
          next ? label("expand_legend") : label("collapse_legend")
        );
        IMB.qa.legendCollapsed = next;
      }
      legendToggle.addEventListener("click", function () {
        setLegendCollapsed(!legendPanel.classList.contains("is-collapsed"));
      });
      setLegendCollapsed(
        Boolean(window.matchMedia && window.matchMedia("(max-width: 700px)").matches)
      );
      var collapse = document.getElementById("imb-collapse");
      collapse.textContent = label("collapse");
      var search = document.getElementById("imb-search");
      document.getElementById("imb-feature-type-label").textContent =
        label("search_layer");

      var map = IMB.setupMap();
      IMB.addBasemap(map, spec, payload.catalog.shared);
      var mapControls = spec.map && spec.map.controls && typeof spec.map.controls === "object"
        ? spec.map.controls
        : {};
      var searchBehavior = IMB.text(
        spec.map && spec.map.search_behavior
          ? spec.map.search_behavior
          : "filter"
      ).toLocaleLowerCase();
      var basemapControlPanel = document.getElementById("imb-basemap-control");
      var layerControlPanel = document.getElementById("imb-layer-control");
      var mapControlsHost = document.getElementById("imb-map-controls");
      if (mapControls.layer_control === false) {
        layerControlPanel.hidden = true;
      }
      if (mapControls.legend === false) {
        legendPanel.hidden = true;
      }
      mapControlsHost.hidden =
        basemapControlPanel.hidden && layerControlPanel.hidden && legendPanel.hidden;

      var globalRegistry = new Map();
      var runtimeLayers = [];
      var totalFeatures = 0;

      layers.forEach(function (layer, layerIndex) {
        var layerSpec = IMB.layerSpec(layer);
        var layerIdentifier = IMB.layerId(layer, layerIndex);
        var layerName = IMB.layerTitle(layer, layerIndex);
        var featureCollection = layer.feature_collection || { type: "FeatureCollection", features: [] };
        var enabled = IMB.firstDefined(
          layerSpec.visible,
          true
        ) !== false;
        var runtime = {
          id: layerIdentifier,
          title: layerName,
          spec: layerSpec,
          source: layer,
          visual: IMB.layerVisual(layer),
          enabled: enabled,
          order: layerIndex,
          group: null,
          entries: [],
          searchFields: IMB.fieldDefinitions(
            layerSpec.search_fields,
            [IMB.labelField(layerSpec)],
            layerSpec
          )
        };
        runtime.group = L.geoJSON(featureCollection, {
          style: function (feature) {
            return IMB.geometryStyle(layerSpec, feature, runtime.visual);
          },
          pointToLayer: function (feature, latlng) {
            return L.circleMarker(latlng, IMB.geometryStyle(layerSpec, feature, runtime.visual));
          },
          onEachFeature: function (feature, leafletLayer) {
            var featureIdentifier = IMB.featureId(
              feature,
              layerSpec,
              layerIdentifier + "-" + (runtime.entries.length + 1)
            );
            var runtimeIdentifier = layerIdentifier + "::" + featureIdentifier;
            var properties = feature && feature.properties ? feature.properties : {};
            var linkValue = layerSpec.link_key
              ? IMB.text(properties[layerSpec.link_key]).trim()
              : "";
            var identifier = linkValue ? "link::" + linkValue : runtimeIdentifier;
            var baseStyle = IMB.geometryStyle(layerSpec, feature, runtime.visual);
            var entry = {
              id: identifier,
              runtimeId: runtimeIdentifier,
              featureId: featureIdentifier,
              feature: feature,
              leaflet: leafletLayer,
              baseStyle: baseStyle,
              visual: runtime.visual,
              runtime: runtime,
              matches: true
            };
            runtime.entries.push(entry);
            if (!globalRegistry.has(identifier)) {
              globalRegistry.set(identifier, []);
            }
            globalRegistry.get(identifier).push(entry);
            IMB.attachFeatureContent(leafletLayer, feature, layerSpec);
            leafletLayer.on("mouseover", function () {
              IMB.link_by_id.emit("highlight", identifier, {
                source: "map",
                layerId: layerIdentifier
              });
            });
            leafletLayer.on("mouseout", function () {
              IMB.link_by_id.clear(identifier, {
                source: "map",
                layerId: layerIdentifier
              });
            });
            leafletLayer.on("click", function () {
              IMB.link_by_id.emit("select", identifier, {
                source: "map",
                layerId: layerIdentifier
              });
            });
          }
        });
        totalFeatures += runtime.entries.length;
        if (enabled) {
          runtime.group.addTo(map);
        }
        runtimeLayers.push(runtime);
      });
      IMB.orderGroups(runtimeLayers);

      IMB.fitToGroups(map, runtimeLayers.filter(function (runtime) {
        return runtime.enabled;
      }).map(function (runtime) {
        return runtime.group;
      }));
      window.setTimeout(function () {
        map.invalidateSize();
        IMB.fitToGroups(map, runtimeLayers.filter(function (runtime) {
          return runtime.enabled;
        }).map(function (runtime) {
          return runtime.group;
        }));
      }, 220);

      var layerOptions = document.getElementById("imb-layer-options");
      runtimeLayers.forEach(function (runtime) {
        var wrapper = IMB.element("label", undefined, "imb-layer-option");
        var checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.checked = runtime.enabled;
        checkbox.dataset.layerId = runtime.id;
        checkbox.addEventListener("change", function () {
          setLayerEnabled(runtime, checkbox.checked);
        });
        var swatch = IMB.element("span", undefined, "imb-swatch");
        var sampleProperties = runtime.entries.length && runtime.entries[0].feature.properties
          ? runtime.entries[0].feature.properties
          : {};
        swatch.style.backgroundColor = IMB.colorFor(runtime.spec, sampleProperties, runtime.visual, runtime.visual.geometry_family || "polygon");
        wrapper.appendChild(checkbox);
        wrapper.appendChild(swatch);
        wrapper.appendChild(IMB.element("span", runtime.title));
        layerOptions.appendChild(wrapper);
      });

      var legendGroups = document.getElementById("imb-legend-groups");
      runtimeLayers.forEach(function (runtime) {
        var groupNode = IMB.element("div", undefined, "imb-legend-group");
        groupNode.appendChild(IMB.element("div", runtime.title, "imb-legend-group-title"));
        var entries = IMB.categoryEntries(runtime.spec);
        if (!entries.length) {
          entries = [{
            label: runtime.title,
            color: IMB.colorFor(runtime.spec, {}, runtime.visual, runtime.visual.geometry_family || "polygon")
          }];
        }
        entries.forEach(function (entry) {
          var row = IMB.element("div", undefined, "imb-legend-item");
          var swatch = IMB.element("span", undefined, "imb-swatch");
          swatch.style.backgroundColor = entry.color || IMB.colorFor(runtime.spec, {}, runtime.visual, runtime.visual.geometry_family || "polygon");
          row.appendChild(swatch);
          row.appendChild(IMB.element("span", entry.label));
          groupNode.appendChild(row);
        });
        legendGroups.appendChild(groupNode);
      });

      var listNode = document.getElementById("imb-list");
      var resultCount = document.getElementById("imb-result-count");
      var resultLimit = document.getElementById("imb-result-limit");
      var statusNode = document.getElementById("imb-status");
      var summary = document.getElementById("imb-summary");
      var overviewButton = document.getElementById("imb-overview-button");
      var layerSelect = document.getElementById("imb-feature-type-select");
      var searchField = document.getElementById("imb-search-field");
      var overviewMessage = document.getElementById("imb-overview-message");
      var searchableLayers = runtimeLayers.slice().sort(function (left, right) {
        return left.order - right.order;
      });
      var resultLimitValue = 200;
      var state = {
        query: "",
        matches: [],
        selectedId: "",
        hoveredId: "",
        activeLayerId: ""
      };

      overviewButton.textContent = label("overview");
      overviewMessage.textContent = label("overview_hint");
      var placeholderOption = document.createElement("option");
      placeholderOption.value = "";
      placeholderOption.textContent = label("layer_placeholder");
      layerSelect.appendChild(placeholderOption);
      searchableLayers.forEach(function (runtime) {
        var option = document.createElement("option");
        option.value = runtime.id;
        option.textContent = runtime.title + " · " + runtime.entries.length;
        layerSelect.appendChild(option);
      });

      function isOverview() {
        return !state.activeLayerId;
      }

      function activeRuntime() {
        if (isOverview()) {
          return null;
        }
        return searchableLayers.find(function (runtime) {
          return runtime.id === state.activeLayerId;
        }) || null;
      }

      function refreshVisualStates() {
        var visualStates = {};
        runtimeLayers.forEach(function (runtime) {
          var runtimeState = isOverview()
            ? "base"
            : (runtime.id === state.activeLayerId ? "focus" : "dimmed");
          visualStates[runtime.id] = runtimeState;
          runtime.entries.forEach(function (entry) {
            var next = runtimeState;
            if (!entry.matches) {
              next = "dimmed";
            }
            if (entry.id === state.hoveredId) {
              next = "hover";
            }
            if (entry.id === state.selectedId) {
              next = "selected";
            }
            IMB.applyEntryState(entry, next);
          });
        });
        IMB.orderGroups(runtimeLayers);
        IMB.qa.layerVisualStates = visualStates;
      }

      function updateTypeControls() {
        var runtime = activeRuntime();
        var overview = !runtime;
        IMB.qa.activeLayerId = runtime ? runtime.id : "";
        IMB.qa.overview = overview;
        overviewButton.setAttribute("aria-pressed", overview ? "true" : "false");
        layerSelect.value = runtime ? runtime.id : "";
        layerSelect.classList.toggle("is-active", !overview);
        searchField.hidden = overview;
        statusNode.hidden = overview;
        listNode.hidden = overview;
        overviewMessage.hidden = !overview;
        search.disabled = overview;
        if (overview) {
          document.getElementById("imb-search-label").textContent = label("search");
          search.placeholder = label("overview_hint");
          listNode.setAttribute("aria-label", label("overview"));
          return;
        }
        var fieldLabels = runtime.searchFields.map(function (definition) {
          return definition.label;
        });
        document.getElementById("imb-search-label").textContent =
          fieldLabels.join(strings.field_separator) || label("search");
        search.placeholder =
          strings.search_prefix
          + (fieldLabels.join(strings.field_separator) || runtime.title);
        listNode.setAttribute(
          "aria-label",
          runtime.title + strings.search_results_suffix
        );
      }

      function entryText(entry) {
        var props = entry.feature && entry.feature.properties ? entry.feature.properties : {};
        return entry.runtime.searchFields.map(function (definition) {
          return IMB.text(props[definition.field]);
        }).join(" ").toLocaleLowerCase();
      }

      function renderSearchResults() {
        listNode.replaceChildren();
        var runtime = activeRuntime();
        if (!runtime) {
          resultCount.textContent = "";
          resultLimit.textContent = "";
          IMB.qa.visibleRecordCount = 0;
          IMB.qa.renderedListCount = 0;
          return;
        }
        var visibleMatches = state.matches.slice(0, resultLimitValue);
        var fragment = document.createDocumentFragment();
        visibleMatches.forEach(function (entry) {
          var props = entry.feature && entry.feature.properties ? entry.feature.properties : {};
          var card = IMB.element("button", undefined, "imb-list-card");
          card.type = "button";
          card.setAttribute("role", "option");
          card.setAttribute("aria-selected", entry.id === state.selectedId ? "true" : "false");
          card.dataset.featureId = entry.id;
          card.appendChild(IMB.element(
            "span",
            IMB.firstDefined(props.__label, entry.featureId),
            "imb-card-title"
          ));
          var meta = IMB.element("span", undefined, "imb-card-meta");
          meta.appendChild(IMB.element("span", entry.runtime.title, "imb-card-meta-item"));
          card.appendChild(meta);
          fragment.appendChild(card);
        });
        listNode.appendChild(fragment);
        IMB.bindLinkedElements(listNode);
        if (!state.matches.length) {
          listNode.appendChild(IMB.element(
            "p",
            label("empty") + " · " + runtime.title,
            "imb-empty"
          ));
        }
        resultCount.textContent = runtime.title + ": " + state.matches.length;
        resultLimit.textContent = state.matches.length > resultLimitValue
          ? label("limited") + " " + resultLimitValue
          : "";
        IMB.qa.visibleRecordCount = state.matches.length;
        IMB.qa.renderedListCount = visibleMatches.length;
      }

      function applySearch() {
        state.query = isOverview() ? "" : search.value.trim().toLocaleLowerCase();
        state.matches = [];
        runtimeLayers.forEach(function (runtime) {
          var isActiveLayer = !isOverview() && runtime.id === state.activeLayerId;
          if (searchBehavior === "filter") {
            runtime.group.clearLayers();
          }
          runtime.entries.forEach(function (entry) {
            entry.matches =
              !isActiveLayer
              || !state.query
              || entryText(entry).indexOf(state.query) !== -1;
            if (searchBehavior === "highlight") {
              if (!runtime.group.hasLayer(entry.leaflet)) {
                runtime.group.addLayer(entry.leaflet);
              }
            } else if (!isActiveLayer || entry.matches) {
              runtime.group.addLayer(entry.leaflet);
            }
            if (isActiveLayer && entry.matches) {
              state.matches.push(entry);
            }
          });
        });
        refreshVisualStates();
        IMB.qa.mapFeatureCount = runtimeLayers.reduce(function (count, runtime) {
          return count + runtime.group.getLayers().length;
        }, 0);
        renderSearchResults();
      }

      function clearSelection() {
        state.selectedId = "";
        state.hoveredId = "";
        IMB.qa.selectedLinkId = "";
        if (map.closePopup) {
          map.closePopup();
        }
      }

      function setActiveLayer(layerIdentifier) {
        var requested = IMB.text(layerIdentifier);
        var runtime = requested
          ? searchableLayers.find(function (candidate) { return candidate.id === requested; })
          : null;
        if (requested && !runtime) {
          return false;
        }
        if (runtime && !runtime.enabled) {
          var checkbox = Array.prototype.find.call(
            layerOptions.querySelectorAll("input[data-layer-id]"),
            function (node) { return node.dataset.layerId === runtime.id; }
          );
          if (checkbox) {
            checkbox.checked = true;
          }
          runtime.enabled = true;
          if (!map.hasLayer(runtime.group)) {
            runtime.group.addTo(map);
          }
        }
        state.activeLayerId = runtime ? runtime.id : "";
        search.value = "";
        clearSelection();
        updateTypeControls();
        applySearch();
        updateSummary();
        return true;
      }

      function setLayerEnabled(runtime, enabled) {
        runtime.enabled = Boolean(enabled);
        if (runtime.enabled) {
          if (!map.hasLayer(runtime.group)) {
            runtime.group.addTo(map);
          }
        } else if (map.hasLayer(runtime.group)) {
          map.removeLayer(runtime.group);
        }
        if (!runtime.enabled && state.activeLayerId === runtime.id) {
          setActiveLayer("");
          return;
        }
        refreshVisualStates();
        updateSummary();
      }

      function updateSummary() {
        var enabledCount = runtimeLayers.filter(function (runtime) {
          return runtime.enabled;
        }).length;
        summary.replaceChildren(
          IMB.element("span", label("visible_layers") + ": " + enabledCount),
          IMB.element("span", label("features") + ": " + totalFeatures)
        );
      }

      function selectFeature(identifier, source) {
        if (state.selectedId && state.selectedId !== identifier) {
          IMB.applyLinkedDomState(state.selectedId, false, false);
          Array.prototype.forEach.call(listNode.querySelectorAll("[aria-selected='true']"), function (node) {
            node.setAttribute("aria-selected", "false");
          });
        }
        state.selectedId = identifier;
        IMB.qa.selectedLinkId = identifier;
        refreshVisualStates();
        IMB.applyLinkedDomState(identifier, true, true);
        var matchingNode = Array.prototype.find.call(
          listNode.querySelectorAll("[data-feature-id]"),
          function (node) { return node.dataset.featureId === identifier; }
        );
        if (matchingNode) {
          matchingNode.setAttribute("aria-selected", "true");
          if (source !== "dom" && source !== "keyboard") {
            matchingNode.scrollIntoView({ block: "nearest", behavior: "smooth" });
          }
        }
        var entries = globalRegistry.get(identifier) || [];
        var visibleEntry = entries.find(function (entry) {
          return entry.runtime.enabled && entry.matches;
        }) || entries[0];
        if (visibleEntry && source !== "map") {
          if (!visibleEntry.runtime.enabled) {
            var checkbox = Array.prototype.find.call(
              layerOptions.querySelectorAll("input[data-layer-id]"),
              function (node) { return node.dataset.layerId === visibleEntry.runtime.id; }
            );
            if (checkbox) {
              checkbox.checked = true;
            }
            setLayerEnabled(visibleEntry.runtime, true);
          }
          if (visibleEntry.leaflet.getBounds && visibleEntry.leaflet.getBounds().isValid()) {
            map.fitBounds(visibleEntry.leaflet.getBounds(), { padding: [40, 40], maxZoom: 16 });
          } else if (visibleEntry.leaflet.getLatLng) {
            map.panTo(visibleEntry.leaflet.getLatLng());
          }
          if (visibleEntry.leaflet.openPopup) {
            visibleEntry.leaflet.openPopup();
          }
        }
      }

      IMB.link_by_id.on("highlight", function (event) {
        if (
          state.hoveredId
          && state.hoveredId !== state.selectedId
          && state.hoveredId !== event.id
        ) {
          IMB.applyLinkedDomState(state.hoveredId, false, false);
        }
        state.hoveredId = event.id;
        refreshVisualStates();
        IMB.applyLinkedDomState(event.id, true, false);
      });
      IMB.link_by_id.on("clear", function (event) {
        if (event.id !== state.selectedId) {
          IMB.applyLinkedDomState(event.id, false, false);
        }
        if (state.hoveredId === event.id) {
          state.hoveredId = "";
        }
        refreshVisualStates();
      });
      IMB.link_by_id.on("select", function (event) {
        selectFeature(event.id, event.source);
      });

      search.addEventListener("input", applySearch);
      overviewButton.addEventListener("click", function () {
        setActiveLayer("");
      });
      layerSelect.addEventListener("change", function () {
        setActiveLayer(layerSelect.value);
      });
      collapse.addEventListener("click", function () {
        var app = document.getElementById("imb-app");
        var collapsed = app.classList.toggle("is-sidebar-collapsed");
        collapse.setAttribute("aria-expanded", collapsed ? "false" : "true");
        collapse.textContent = collapsed ? label("expand") : label("collapse");
        window.setTimeout(function () { map.invalidateSize(); }, 220);
      });

      updateSummary();
      updateTypeControls();
      applySearch();
      IMB.qa.actions.setFeatureType = function (layerIdentifier) {
        return setActiveLayer(layerIdentifier);
      };
      IMB.qa.actions.setOverview = function () {
        return setActiveLayer("");
      };
      IMB.qa.actions.setSearch = function (value) {
        search.value = IMB.text(value);
        applySearch();
      };
      IMB.qa.actions.toggleLayer = function (layerIdentifier, enabled) {
        var runtime = runtimeLayers.find(function (candidate) {
          return candidate.id === IMB.text(layerIdentifier);
        });
        if (!runtime) {
          return false;
        }
        var checkbox = Array.prototype.find.call(
          layerOptions.querySelectorAll("input[data-layer-id]"),
          function (node) { return node.dataset.layerId === runtime.id; }
        );
        if (checkbox) {
          checkbox.checked = Boolean(enabled);
        }
        setLayerEnabled(runtime, enabled);
        return true;
      };
      IMB.qa.actions.selectFeature = function (identifier) {
        if (!globalRegistry.has(IMB.text(identifier))) {
          return false;
        }
        selectFeature(IMB.text(identifier), "qa");
        return true;
      };
      IMB.qa.actions.toggleLegend = function (collapsed) {
        setLegendCollapsed(Boolean(collapsed));
        return true;
      };
      IMB.finish("multilayer", {
        recordCount: totalFeatures,
        visibleRecordCount: state.matches.length,
        renderedListCount: Math.min(state.matches.length, resultLimitValue),
        visualSystem: "atlas-studio-light",
        visualPlans: runtimeLayers.reduce(function (plans, runtime) {
          plans[runtime.id] = runtime.visual;
          return plans;
        }, {}),
        layerDrawOrder: runtimeLayers.slice().sort(function (left, right) {
          return Number(left.visual.draw_order || 0) - Number(right.visual.draw_order || 0);
        }).map(function (runtime) { return runtime.id; }),
        layerCounts: runtimeLayers.reduce(function (counts, runtime) {
          counts[runtime.id] = Number(runtime.source.count || runtime.entries.length);
          return counts;
        }, {}),
        layerStyleColors: runtimeLayers.reduce(function (colors, runtime) {
          colors[runtime.id] = Array.from(new Set(runtime.entries.map(function (entry) {
            return entry.baseStyle.color;
          })));
          return colors;
        }, {}),
        linkGroupSizes: Array.from(globalRegistry.entries()).reduce(function (sizes, pair) {
          sizes[pair[0]] = pair[1].length;
          return sizes;
        }, {})
      });
    });
  }());
  </script>
</body>
</html>
